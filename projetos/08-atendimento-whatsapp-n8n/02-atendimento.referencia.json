      "position": [
        260,
        440
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COALESCE((SELECT data FROM wa_sessions WHERE phone=$1),'{}'::jsonb) AS session, $2::jsonb AS contact;",
        "options": {
