    {
      "id": "node-19",
      "name": "Formatar rastreamento",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        660
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst r={...$('Decidir atendimento').item.json};const b=$json.body;\nconst ok=$json.statusCode>=200&&$json.statusCode<300&&b?.autorizado===true&&b?.status;\nr.action='text';r.text=ok?'Pedido '+r.order+': '+b.status+'. Previsão: '+(b.previsao_entrega||'ainda não informada')+'.':'Não consegui consultar esse pedido. Confira o código ou digite 4 para falar com um vendedor.';\nr.text+='\\n\\nPosso ajudar em algo mais?';if(!ok)r.erro_envio='Falha na consulta de rastreamento';return {json:r};"
      }
    },
    {
      "id": "node-20",
      "name": "Formatar frete",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        660
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst r={...$('Decidir atendimento').item.json};const b=$json.body;\nconst options=Array.isArray(b?.opcoes)?b.opcoes.filter(o=>Number.isFinite(o.valor)&&o.valor>=0&&Number.isInteger(o.prazo_dias_uteis)&&o.prazo_dias_uteis>=0):[];\nconst ok=$json.statusCode>=200&&$json.statusCode<300&&options.length>0;\nr.action='text';r.text=ok?options.slice(0,8).map(o=>o.servico+': '+o.valor.toLocaleString('pt-BR',{style:'currency',currency:'BRL'})+' — '+o.prazo_dias_uteis+' dias úteis').join('\\n'):'Não consegui calcular o frete. Digite 4 para falar com um vendedor.';\nr.text+='\\n\\nPosso ajudar em algo mais?';if(!ok)r.erro_envio='Falha na consulta de frete';return {json:r};"
      }
    },
